{
  "manifest_version": 3,
  "name": "Repli",
  "version": "1.0.0",
  "description": "Generate AI replies directly on X/Twitter using Repli",
  "action": {
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["src/content/index.ts"],
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ]
}
